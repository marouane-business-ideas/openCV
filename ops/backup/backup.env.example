# Template of /etc/onlineresume-backup.env on the server (owned by root, chmod 600). See ARCHITECTURE.md

# age public key the backups are encrypted with. Its private key is kept off the server: only it can decrypt them
AGE_RECIPIENT=age1...

R2_BUCKET=onlineresume-backups

# rclone's "r2" remote, from the R2 API token (Object Read & Write, on this bucket only)
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
# The token can't list or create buckets: don't let rclone try
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
