# Copy to .env.development.local and fill in: the backend's secrets, never committed.
# The other settings are in .env.development. Without these, the server starts but the features using them fail.
STRIPE_SECRET_KEY=
# Printed by `stripe listen --forward-to localhost:1337/api/webhook/stripe`
STRIPE_WEBHOOK_SIGNING_SECRET=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
GMAIL_APP_PASSWORD=
