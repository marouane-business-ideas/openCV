{
  "name": "resumebuilder",
  "version": "1.1.1",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "start:backend": "npm run start --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "build": "concurrently \"npm run build:frontend\" \"npm run build:backend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "dev": "npm run build:backend && concurrently \"npm:dev:backend\" \"npm:start:frontend\"",
    "preview": "npm run build && concurrently \"npm:start:backend\" \"npm run preview --prefix frontend\""
  },
  "keywords": [],
  "author": "Marouane Faris",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.6.0",
    "react-router-dom": "^6.26.1"
  }
}
